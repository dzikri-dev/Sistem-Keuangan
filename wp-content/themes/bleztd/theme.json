{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "1000px",
			"wideSize": "1280px"
		},
		"useRootPaddingAwareAlignments": true,
		"color": {
			"palette": [
				{
					"slug": "primary",
					"color": "#2f6bff",
					"name": "Primary"
				},
				{
					"slug": "background",
					"color": "#0b0d14",
					"name": "Background"
				},
				{
					"slug": "surface",
					"color": "#0f1420",
					"name": "Surface"
				},
				{
					"slug": "surfaceAlt",
					"color": "#121726",
					"name": "SurfaceAlt"
				},
				{
					"slug": "text",
					"color": "#f4f5f8",
					"name": "Text"
				},
				{
					"slug": "textMuted",
					"color": "#9aa0b0",
					"name": "TextMuted"
				},
				{
					"slug": "accent",
					"color": "#ff3d8a",
					"name": "Accent"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "space-grotesk",
					"name": "Space Grotesk",
					"fontFamily": "\"Space Grotesk\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Space Grotesk",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/space-grotesk/space-grotesk-700-vietnamese.woff2"
							],
							"unicodeRange": "U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB"
						},
						{
							"fontFamily": "Space Grotesk",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/space-grotesk/space-grotesk-700-latin-ext.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Space Grotesk",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/space-grotesk/space-grotesk-700-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "albert-sans",
					"name": "Albert Sans",
					"fontFamily": "\"Albert Sans\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Albert Sans",
							"fontStyle": "normal",
							"fontWeight": "400 600",
							"src": [
								"file:./assets/fonts/albert-sans/albert-sans-400-600-latin-ext.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Albert Sans",
							"fontStyle": "normal",
							"fontWeight": "400 600",
							"src": [
								"file:./assets/fonts/albert-sans/albert-sans-400-600-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "display",
					"size": "clamp(2.75rem, 7vw, 5rem)",
					"name": "Display"
				},
				{
					"slug": "body",
					"size": "1rem",
					"name": "Body"
				},
				{
					"slug": "label",
					"size": "0.75rem",
					"name": "Label"
				}
			]
		},
		"spacing": {
			"spacingSizes": [
				{
					"slug": "sm",
					"size": "16px",
					"name": "Small"
				},
				{
					"slug": "md",
					"size": "40px",
					"name": "Medium"
				},
				{
					"slug": "lg",
					"size": "88px",
					"name": "Large"
				}
			]
		},
		"custom": {
			"rounded": {
				"sm": "16px",
				"md": "24px",
				"full": "999px"
			}
		}
	},
	"styles": {
		"spacing": {
			"padding": {
				"top": "0px",
				"right": "clamp(1.25rem, 5vw, 3rem)",
				"bottom": "0px",
				"left": "clamp(1.25rem, 5vw, 3rem)"
			}
		},
		"color": {
			"background": "var:preset|color|background",
			"text": "var:preset|color|text"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|albert-sans",
			"fontSize": "var:preset|font-size|body",
			"lineHeight": "1.55"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|space-grotesk",
					"fontWeight": "700",
					"lineHeight": "0.95",
					"letterSpacing": "-0.04em"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|primary"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "#ffffff"
				},
				"border": {
					"radius": "999px"
				},
				"spacing": {
					"padding": {
						"top": "12px",
						"right": "24px",
						"bottom": "12px",
						"left": "24px"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|albert-sans",
					"fontSize": "var:preset|font-size|label",
					"fontWeight": "600",
					"letterSpacing": "0.14em",
					"textTransform": "uppercase"
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "page-no-title",
			"title": "Page (no title)",
			"postTypes": [
				"page"
			]
		}
	]
}
